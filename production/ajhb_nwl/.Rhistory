table(df$postbirth_death, useNA = "ifany")
table(df$deceased_day, useNA = "ifany")
table(df$day_of_death, useNA = "ifany")
table(df$day_of_death_pooled, useNA = "ifany")
table(df$neonat_mort_day1, useNA = "ifany")
table(df$neonat_mort_d1_d5, useNA = "ifany")
table(df_analysis_clean$postbirth_death, useNA = "ifany")
df_analysis_clean %>%
filter(postbirth_death == 1) %>%
count(day_of_death_pooled, sort = TRUE)
df_analysis_clean %>%
mutate(
n_weights = (!is.na(weight_a)) + (!is.na(weight_b))
) %>%
group_by(n_weights) %>%
summarise(
N = n(),
deaths = sum(postbirth_death == 1, na.rm = TRUE),
mortality_pct = 100 * mean(postbirth_death == 1, na.rm = TRUE)
)
df_analysis_clean %>%
filter(postbirth_death == 1) %>%
summarise(
deaths_total = n(),
death_day_missing = sum(is.na(day_of_death_pooled)),
deaths_day_0_28 = sum(
!is.na(day_of_death_pooled) &
day_of_death_pooled >= 0 &
day_of_death_pooled <= 28
),
deaths_after_day_28 = sum(
!is.na(day_of_death_pooled) &
day_of_death_pooled > 28
)
)
df_analysis_clean %>%
mutate(
n_weights = (!is.na(weight_a)) + (!is.na(weight_b)),
neonatal_death_28 =
postbirth_death == 1 &
!is.na(day_of_death_pooled) &
day_of_death_pooled >= 0 &
day_of_death_pooled <= 28
) %>%
group_by(n_weights) %>%
summarise(
N = n(),
neonatal_deaths = sum(neonatal_death_28),
neonatal_mortality_pct = 100 * mean(neonatal_death_28)
)
df_analysis_clean %>%
mutate(
exact_day5_day10 =
!is.na(weight_a) & !is.na(weight_b) &
!is.na(day_a) & !is.na(day_b) &
day_a == 5 & day_b == 10,
neonatal_death_28 =
postbirth_death == 1 &
!is.na(day_of_death_pooled) &
day_of_death_pooled >= 0 &
day_of_death_pooled <= 28
) %>%
group_by(exact_day5_day10) %>%
summarise(
N = n(),
neonatal_deaths = sum(neonatal_death_28),
neonatal_mortality_pct = 100 * mean(neonatal_death_28)
)
survivors_one_measurement <- df_analysis_clean %>%
mutate(
n_weights = (!is.na(weight_a)) + (!is.na(weight_b)),
neonatal_death_28 =
postbirth_death == 1 &
!is.na(day_of_death_pooled) &
day_of_death_pooled >= 0 &
day_of_death_pooled <= 28
) %>%
filter(
n_weights == 1,
neonatal_death_28 == FALSE
)
nrow(survivors_one_measurement)
survivors_one_measurement %>%
summarise(
only_first = sum(!is.na(weight_a) & is.na(weight_b)),
only_second = sum(is.na(weight_a) & !is.na(weight_b))
)
survivors_one_measurement %>%
select(
keyid,
day_a, weight_a,
day_b, weight_b,
postbirth_death,
day_of_death_pooled,
homebirth,
comment
)
survivors_one_measurement %>%
mutate(
observed_day = ifelse(!is.na(day_a), day_a, day_b)
) %>%
count(observed_day, sort = TRUE)
survivors_one_measurement %>%
summarise(
N = n(),
comment_present = sum(
!is.na(comment) & trimws(comment) != ""
),
homebirth_yes = sum(
tolower(trimws(as.character(homebirth))) == "yes",
na.rm = TRUE
)
)
survivors_one_measurement %>%
filter(!is.na(comment), trimws(comment) != "") %>%
select(
keyid, day_a, weight_a, day_b, weight_b,
homebirth, comment
) %>%
print(n = Inf)
